{
  "name": "migration-guard",
  "version": "0.0.1",
  "description": "Schema Migration Guard \u2014 a cloud-DB agentic demo built on the Loom kernel: inspect a table, ask Gemini to rate migration risk, pause for a human DBA on risky changes, then apply. One flow, two surfaces (headless terminal + React UI). Consumes the sibling ../loom packages via link: deps.",
  "private": true,
  "scripts": {
    "gen": "loom gen --dir app",
    "build": "tsc --build",
    "start": "tsx src/main.ts",
    "inspect": "loom inspect --db .data/events.db --port 35789",
    "crash": "tsx src/pitch-crash.ts",
    "resume": "tsx src/pitch-resume.ts",
    "fork": "tsx src/pitch-fork.ts",
    "propensity": "tsx src/pitch-propensity.ts",
    "pitch:reset": "rm -rf .data",
    "dev": "vite",
    "build:ui": "vite build",
    "test": "vitest run",
    "demo:stub": "cp app/flows/migration-guard/flow.stub.txt app/flows/migration-guard/flow.ts",
    "demo:restore": "git checkout -- app/flows/migration-guard/flow.ts",
    "clean": "rm -rf dist .data tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loomwork/agent-surface": "link:../loom/packages/agent-surface",
    "@loomwork/analytics": "link:../loom/packages/analytics",
    "@loomwork/app": "link:../loom/packages/app",
    "@loomwork/core": "link:../loom/packages/core",
    "@loomwork/dispatcher": "link:../loom/packages/dispatcher",
    "@loomwork/effect-runtime": "link:../loom/packages/effect-runtime",
    "@loomwork/event-runtime": "link:../loom/packages/event-runtime",
    "@loomwork/learning": "link:../loom/packages/learning",
    "@loomwork/llm": "link:../loom/packages/llm",
    "@loomwork/middleware": "link:../loom/packages/middleware",
    "@loomwork/plugin-renderer-react": "link:../loom/plugins/renderer-react",
    "@loomwork/plugin-sqlite": "link:../loom/plugins/sqlite",
    "@loomwork/projection-runtime": "link:../loom/packages/projection-runtime",
    "@loomwork/snapshot-runtime": "link:../loom/packages/snapshot-runtime",
    "@loomwork/worker-runtime-local": "link:../loom/packages/worker-runtime-local",
    "@loomwork/workflow-runtime": "link:../loom/packages/workflow-runtime",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loomwork/cli": "link:../loom/tools/cli",
    "@loomwork/testing": "link:../loom/tools/testing",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
